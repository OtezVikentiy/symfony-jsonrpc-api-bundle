parameters:
    level: 9
    paths:
        - src

    # The manifest allows ^6.4 || ^7.0 || ^8.0, so the same source is analysed
    # against three different sets of Symfony type declarations, and what each
    # one can prove differs. An ignore that is required on 6.4 goes unused on 8
    # and vice versa, so an unmatched ignore here means "another branch needed
    # it", not "this one is stale".
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Symfony's Config Definition Builder fluent API returns the generic
        # NodeParentInterface from end(), not the concrete NodeBuilder that
        # actually comes back at runtime. Without the phpstan-symfony
        # extension (a dependency this bundle does not otherwise need),
        # PHPStan has no way to know that chaining another *Node() call
        # after end() is valid. Scoped to the one line where PHPStan reports
        # it (further calls in the same chain fall back to mixed and go
        # unchecked, so only one occurrence is ever reported here) rather
        # than a generated baseline.
        -
            message: '#^Call to an undefined method Symfony\\Component\\Config\\Definition\\Builder\\NodeParentInterface::\w+\(\)\.$#'
            path: src/DependencyInjection/Configuration.php

        # Same fluent API, different wording: on Symfony 6.4 end() is typed
        # NodeParentInterface|null rather than NodeParentInterface.
        -
            message: '#^Cannot call method \w+\(\) on Symfony\\Component\\Config\\Definition\\Builder\\NodeParentInterface\|null\.$#'
            path: src/DependencyInjection/Configuration.php

        # Symfony 8 made TreeBuilder generic, so there getRootNode() is already
        # typed as the concrete node and the guard below it is provably
        # redundant. On 6.4 and 7 it is a real narrowing that throws on a tree
        # whose root is not an array node, so the guard stays and the certainty
        # is ignored rather than the code removed.
        -
            message: '#^Instanceof between Symfony\\Component\\Config\\Definition\\Builder\\ArrayNodeDefinition.* and Symfony\\Component\\Config\\Definition\\Builder\\ArrayNodeDefinition will always evaluate to true\.$#'
            path: src/DependencyInjection/Configuration.php

        # These two identifiers are level 6+'s "add array-shape docblocks
        # everywhere" checks. At level 9 they account for 104 of the 132
        # findings in src/ (88 missingType.iterableValue, 16
        # missingType.generics), none of them bugs — every one is a request
        # to add an `array<string, X>`/`ReflectionClass<T>` annotation on an
        # existing, already-correct signature. Closing them properly means
        # threading precise shapes through most of the 65 files in src/,
        # which is a typing-completeness project on its own, not a fix for
        # this release's perimeter work. Disabled by identifier rather than
        # by level so every *other* level 9 check keeps running - level 7-9
        # is exactly what caught the real bugs this task fixed (nullable/
        # union-type crashes, mixed propagating into typed parameters), and
        # dropping the level to silence the annotation noise would have
        # silently dropped those checks too.
        -
            identifier: missingType.iterableValue
            path: src
        -
            identifier: missingType.generics
            path: src
