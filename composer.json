{
  "name": "otezvikentiy/json-rpc-api",
  "description": "Symfony bundle for building JSON-RPC 2.0 APIs: attribute-driven methods, DTO validation, batch requests, API versioning, OpenAPI/Swagger generation and hardened security defaults",
  "keywords": [
    "symfony",
    "symfony-bundle",
    "json-rpc",
    "json-rpc-2.0",
    "jsonrpc",
    "rpc",
    "api",
    "openapi",
    "swagger"
  ],
  "type": "symfony-bundle",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/OtezVikentiy/symfony-jsonrpc-api-bundle/issues",
    "source": "https://github.com/OtezVikentiy/symfony-jsonrpc-api-bundle",
    "docs": "https://github.com/OtezVikentiy/symfony-jsonrpc-api-bundle/tree/master/docs",
    "security": "https://github.com/OtezVikentiy/symfony-jsonrpc-api-bundle/security/policy"
  },
  "autoload": {
    "psr-4": {
      "OV\\JsonRPCAPIBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OV\\JsonRPCAPIBundle\\Tests\\": "tests/",
      "OV\\JsonRPCAPIBundle\\RPC\\": "tests/Fixtures/RPC/"
    }
  },
  "require": {
    "php": "8.2.* || 8.3.* || 8.4.* || 8.5.*",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
    "symfony/routing": "^6.4 || ^7.0 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
    "symfony/validator": "^6.4 || ^7.0 || ^8.0",
    "symfony/serializer": "^6.4 || ^7.0 || ^8.0",
    "symfony/console": "^6.4 || ^7.0 || ^8.0",
    "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/string": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.34.2",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "11.*",
    "symfony/property-access": "^6.4 || ^7.0 || ^8.0"
  },
  "authors": [
    {
      "name": "l.groshev",
      "email": "OtezVikentiy@gmail.com",
      "homepage": "https://otezvikentiy.tech",
      "role": "Creator"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "stan": "phpstan analyse --no-progress",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "infection": "infection --threads=max",
    "ci": [
      "@lint",
      "@stan",
      "@cs",
      "@test"
    ]
  }
}
